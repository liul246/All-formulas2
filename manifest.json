  "shortcuts": [
    {
      "name": "Scientific Calculator",
      "short_name": "Calc",
      "description": "Open scientific calculator",
      "url": "./index.html?tab=calc",
      "icons": [{ "src": "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 96 96'><text y='.9em' font-size='90'>🧮</text></svg>", "sizes": "96x96", "type": "image/svg+xml" }]
    },
    {
      "name": "Graph Plotter",
      "short_name": "Graph",
      "description": "Plot mathematical functions",
      "url": "./index.html?tab=graph",
      "icons": [{ "src": "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 96 96'><text y='.9em' font-size='90'>📈</text></svg>", "sizes": "96x96", "type": "image/svg+xml" }]
    },
    {
      "name": "Unit Converter",
      "short_name": "Convert",
      "description": "Convert between units",
      "url": "./index.html?tab=convert",
      "icons": [{ "src": "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 96 96'><text y='.9em' font-size='90'>🔄</text></svg>", "sizes": "96x96", "type": "image/svg+xml" }]
    },
    {
      "name": "Equation Solver",
      "short_name": "Solve",
      "description": "Solve equations",
      "url": "./index.html?tab=solve",
      "icons": [{ "src": "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 96 96'><text y='.9em' font-size='90'>🧠</text></svg>", "sizes": "96x96", "type": "image/svg+xml" }]
    },
    {
      "name": "New Calculation",
      "short_name": "New",
      "description": "Start a fresh calculation",
      "url": "./index.html?action=new",
      "icons": [{ "src": "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 96 96'><text y='.9em' font-size='90'>➕</text></svg>", "sizes": "96x96", "type": "image/svg+xml" }]
    }
  ],

  "protocol_handlers": [
    {
      "protocol": "web+calc",
      "url": "./index.html?expr=%s"
    },
    {
      "protocol": "web+math",
      "url": "./index.html?solve=%s"
    }
  ],

  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },

  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/plain": [".txt", ".csv"],
        "text/csv": [".csv"],
        "application/json": [".json"]
      }
    }
  ],

  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },

  "edge_side_panel": {
    "preferred_width": 400
  },

  "tabbed": {
    "home_tab": {
      "scope_patterns": [
        { "pathname": "/index.html" },
        { "pathname": "/index.html?tab=calc" }
      ]
    },
    "new_tab_button": {
      "url": "./index.html?tab=calc",
      "label": "New Calculation"
    }
  },

  "note_taking": {
    "new_note_url": "./index.html?tab=calc&mode=note"
  },

  "scope_extensions": [
    {
      "type": "origin",
      "origin": "https://yourdomain.com"
    },
    {
      "type": "origin",
      "origin": "https://cdn.yourdomain.com"
    }
  ],

  "widgets": [
    {
      "name": "Quick Calculator",
      "short_name": "Calc",
      "description": "Fast access to basic calculator",
      "tag": "quick-calc",
      "template": "2x2",
      "ms_ac_template": "./index.html?widget=quick",
      "data": "./index.html?widget=quick",
      "type": "application/xml",
      "screenshots": [
        {
          "src": "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 200'%3E%3Crect width='400' height='200' rx='20' fill='%230a0a0f'/%3E%3Ctext x='200' y='120' font-size='60' text-anchor='middle'%3E%F0%9F%A7%AE%3C/text%3E%3C/svg%3E",
          "sizes": "400x200",
