{
  "id": "/calc-pro-max/",
  "name": "Calculator Pro Max",
  "short_name": "Calc Pro",
  "description": "Advanced scientific calculator with graph, converter, solver, constants, matrix and widgets",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui",
    "fullscreen"
  ],
  "orientation": "portrait-primary",
  "background_color": "#0a0a0f",
  "theme_color": "#0a0a0f",
  "lang": "en",
  "dir": "ltr",
  "categories": ["utilities", "productivity", "education", "tools"],
  "iarc_rating_id": "e5c5e5a5-5e5e-5e5e-5e5e-5e5e5e5e5e5e",
  "prefer_related_applications": false,

  "related_applications": [],

  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "monochrome"
    },
    {
      "src": "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'%3E%3Crect width='512' height='512' rx='100' fill='%230a0a0f'/%3E%3Ctext x='256' y='340' font-size='260' text-anchor='middle'%3E%F0%9F%A7%AE%3C/text%3E%3C/svg%3E",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],

  "screenshots": [
    {
      "src": "./icons/screenshot-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Calculator on mobile"
    },
    {
      "src": "./icons/screenshot-desktop.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Calculator on desktop"
    }
  ],

  "shortcuts": [
    {
      "name": "Scientific Calculator",
      "short_name": "Calc",
      "description": "Open scientific calculator",
      "url": "./index.html?tab=calc",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Graph Plotter",
      "short_name": "Graph",
      "description": "Plot mathematical functions",
      "url": "./index.html?tab=graph",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Unit Converter",
      "short_name": "Convert",
      "description": "Convert between units",
      "url": "./index.html?tab=convert",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Equation Solver",
      "short_name": "Solve",
      "description": "Solve equations",
      "url": "./index.html?tab=solve",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "New Calculation",
      "short_name": "New",
      "description": "Start fresh calculation",
      "url": "./index.html?action=new",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],

  "protocol_handlers": [
    {
      "protocol": "web+calc",
      "url": "./index.html?expr=%s"
    },
    {
      "protocol": "web+math",
      "url": "./index.html?solve=%s"
    }
  ],

  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },

  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/plain": [".txt"],
        "text/csv": [".csv"],
        "application/json": [".json"]
      }
    }
  ],

  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },

  "edge_side_panel": {
    "preferred_width": 400
  },

  "tabbed": {
    "home_tab": {
      "scope_patterns": [
        { "pathname": "/index.html" },
        { "pathname": "/index.html", "search": "?tab=calc" }
      ]
    },
    "new_tab_button": {
      "url": "./index.html?new=1",
      "label": "New Tab"
    }
  },

  "note_taking": {
    "new_note_url": "./index.html?tab=calc&mode=note"
  },

  "scope_extensions": [
    { "type": "origin", "origin": "https://yourdomain.com" }
  ],

  "widgets": [
    {
      "name": "Quick Calculator",
      "short_name": "Calc",
      "description": "Fast access to basic calculator",
      "tag": "quick-calc",
      "template": "2x2",
      "ms_ac_template": "./index.html?widget=quick",
      "data": "./index.html?widget=quick",
      "type": "application/xml",
      "screenshots": [
        {
          "src": "./icons/widget-quick.png",
          "sizes": "400x200",
          "type": "image/png",
          "label": "Quick calc widget"
        }
      ],
      "icons": [
        { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ],
      "auth": false,
      "update": 86400
    }
  ]
}
