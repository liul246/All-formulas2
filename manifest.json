{
  "id": "com.smart.calculator.app",
  "name": "Smart Calculator",
  "short_name": "Calculator",
  "description": "Fast, lightweight, and offline functional calculator application.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0d1117",
  "theme_color": "#0d1117",
  "lang": "en",
  "dir": "ltr",
  "iarc_rating_id": "e84b078d-6a01-443e-a131-7eef277150a0",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.smart.calculator.app",
      "id": "com.smart.calculator.app"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+calc",
      "url": "./index.html?calc=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/plain": [".txt"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "scope_extensions": [
    {
      "type": "origin",
      "origin": "https://akalewold15-cloud.github.io"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "widgets": [
    {
      "name": "Calculator Widget",
      "short_name": "Calc",
      "description": "Quick calculator widget",
      "tag": "calc-widget",
      "template": "widget-template",
      "ms_ac_template": "./widget-template.json",
      "data": "./widget-data.json",
      "type": "text/html",
      "output_security": "sandbox",
      "auth": false,
      "update_interval": 86400,
      "screenshots": [
        {
          "src": "https://via.placeholder.com/540x720.png",
          "sizes": "540x720",
          "type": "image/png",
          "label": "Widget Screenshot"
        }
      ],
      "icons": [
        {
          "src": "https://via.placeholder.com/192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "note_taking": {
    "new_note_url": "./index.html"
  },
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "categories": [
    "utilities",
    "productivity"
  ],
  "icons": [
    {
      "src": "https://via.placeholder.com/192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "https://via.placeholder.com/512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "https://via.placeholder.com/540x720.png",
      "sizes": "540x720",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Calculator Screen"
    }
  ],
  "shortcuts": [
    {
      "name": "Calculator",
      "short_name": "Calc",
      "description": "Open Calculator",
      "url": "./index.html"
    }
  ]
}
