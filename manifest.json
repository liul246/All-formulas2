{
  "id": "/",
  "name": "Calculator Pro Max",
  "short_name": "Calc Pro",
  "description": "Advanced scientific calculator with graph, converter, solver, constants and matrix",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "tabbed", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0a0a0f",
  "theme_color": "#0a0a0f",
  "lang": "en",
  "dir": "ltr",
  "categories": ["utilities", "productivity", "education", "tools"],
  "iarc_rating_id": "e5c5e5a5-5e5e-5e5e-5e5e-5e5e5e5e5e5e",
  "prefer_related_applications": false,

  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.formulashawili.calcpro",
      "id": "com.formulashawili.calcpro"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/calc-pro-max/id0000000000"
    },
    {
      "platform": "webapp",
      "url": "./manifest.json"
    }
  ],

  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ],

  "screenshots": [
    {
      "src": "./screenshot-mobile.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Scientific calculator on mobile"
    }
  ],

  "shortcuts": [
    {
      "name": "Scientific Calculator",
      "short_name": "Calc",
      "description": "Open scientific calculator",
      "url": "./index.html?tab=calc",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Graph Plotter",
      "short_name": "Graph",
      "description": "Plot mathematical functions",
      "url": "./index.html?tab=graph",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Unit Converter",
      "short_name": "Units",
      "description": "Convert between units",
      "url": "./index.html?tab=convert",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Equation Solver",
      "short_name": "Solve",
      "description": "Solve equations",
      "url": "./index.html?tab=solve",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],

  "protocol_handlers": [
    {
      "protocol": "web+calc",
      "url": "./index.html?expr=%s"
    },
    {
      "protocol": "web+math",
      "url": "./index.html?solve=%s"
    }
  ],

  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },

  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/plain": [".txt"],
        "text/csv": [".csv"],
        "application/json": [".json"]
      }
    }
  ],

  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },

  "edge_side_panel": {
    "preferred_width": 400
  },

  "tabbed": {
    "home_tab": {
      "scope_patterns": [
        { "pathname": "/index.html" }
      ]
    },
    "new_tab_button": {
      "url": "./index.html?tab=calc",
      "label": "New Tab"
    }
  },

  "tab_strip": {
    "home_tab": {
      "scope_patterns": [
        { "pathname": "/index.html" }
      ]
    },
    "new_tab_button": {
      "url": "./index.html?tab=calc",
      "label": "New Tab"
    }
  },

  "note_taking": {
    "new_note_url": "./index.html?tab=calc&mode=note"
  },

  "scope_extensions": [
    {
      "type": "origin",
      "origin": "https://formulashawili.vercel.app"
    }
  ],

  "widgets": [
    {
      "name": "Quick Calculator",
      "short_name": "Calc",
      "description": "Fast access to basic calculator",
      "tag": "quick-calc",
      "template": "2x2",
      "ms_ac_template": "./index.html?widget=quick",
      "data": "./index.html?widget=quick",
      "type": "application/xml",
      "auth": false,
      "update": 86400,
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
