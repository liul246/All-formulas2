{
  "id": "./",
  "name": "Calculator Pro Max",
  "short_name": "Calc Pro",
  "description": "Advanced scientific calculator with graph, converter, solver, constants and matrix",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "tabbed",
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "fullscreen"
  ],
  "orientation": "portrait-primary",
  "background_color": "#0a0a0f",
  "theme_color": "#0a0a0f",
  "lang": "en",
  "dir": "ltr",
  "categories": ["utilities", "productivity", "education", "tools"],
  "iarc_rating_id": "e5c5e5a5-5e5e-5e5e-5e5e-5e5e5e5e5e5e",
  "prefer_related_applications": false,
  "related_applications": [],

  "icons": [
    { "src": "./icons/icon-96.png",  "sizes": "96x96",   "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-144.png", "sizes": "144x144", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-384.png", "sizes": "384x384", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],

  "screenshots": [
    {
      "src": "./icons/screenshot-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Scientific calculator on mobile"
    },
    {
      "src": "./icons/screenshot-desktop.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Calculator on desktop"
    }
  ],

  "shortcuts": [
    {
      "name": "Scientific Calculator",
      "short_name": "Calc",
      "description": "Open scientific calculator",
      "url": "./index.html?tab=calc",
      "icons": [{ "src": "./icons/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Graph Plotter",
      "short_name": "Graph",
      "description": "Plot functions",
      "url": "./index.html?tab=graph",
      "icons": [{ "src": "./icons/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Unit Converter",
      "short_name": "Convert",
      "description": "Convert units",
      "url": "./index.html?tab=convert",
      "icons": [{ "src": "./icons/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Equation Solver",
      "short_name": "Solve",
      "description": "Solve equations",
      "url": "./index.html?tab=solve",
      "icons": [{ "src": "./icons/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],

  "protocol_handlers": [
    { "protocol": "web+calc", "url": "./index.html?expr=%s" }
  ],

  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },

  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/plain": [".txt"],
        "text/csv": [".csv"]
      }
    }
  ],

  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },

  "edge_side_panel": { "preferred_width": 400 },

  "tabbed": {
    "home_tab": {
      "scope_patterns": [
        { "pathname": "/index.html" },
        { "pathname": "/index.html", "search": "?tab=calc" }
      ]
    },
    "new_tab_button": {
      "url": "./index.html?tab=calc",
      "label": "New Tab"
    }
  },

  "note_taking": {
    "new_note_url": "./index.html?tab=calc"
  },

  "scope_extensions": []
}
